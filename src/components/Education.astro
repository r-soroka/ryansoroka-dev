---
/**
 * Education: schools and programs, with optional details and coursework.
 *
 * Reads every Markdown file in src/content/education/. To add an entry,
 * add a file there — no changes needed in this component.
 */
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";

// Load all entries and sort them by their `order` field (lowest first).
const entries = (await getCollection("education")).sort(
    (a, b) => a.data.order - b.data.order,
);

// Builds the date line, e.g. "2024 — EXPECTED 2028". With no start date it
// shows just the end ("EXPECTED MAY 2027").
const period = (start?: string, end?: string) =>
    (start ? `${start} — ${end ?? "Now"}` : (end ?? "")).toUpperCase();
---

<section id="education" class="border-t border-line py-14 md:py-18">
    <SectionHeading number="05" title="Education" />

    <ol class="grid gap-5">
        {
            entries.map((entry) => (
                    <li class="grid gap-x-8 gap-y-4 border border-line bg-surface p-6 md:grid-cols-[1fr_1fr] md:p-8">
                        <!-- Left: degree, school and dates. -->
                        <div>
                            <p class="font-mono text-xs text-accent md:text-[13px]">
                                {period(entry.data.start, entry.data.end)}
                            </p>
                            <h3 class="mt-4 text-2xl font-bold">{entry.data.degree}</h3>
                            <p class="mt-1 text-muted">
                                {entry.data.school}
                                {entry.data.location && <span class="text-faint"> · {entry.data.location}</span>}
                            </p>
                            {entry.data.details && (
                                    <p class="mt-3 text-[15px] text-text/80">{entry.data.details}</p>
                            )}
                        </div>

                        <!-- Right: relevant coursework as small tags (only if listed). -->
                        {entry.data.coursework && entry.data.coursework.length > 0 && (
                                <div>
                                    <p class="font-mono text-xs tracking-widest text-faint">RELEVANT COURSEWORK</p>
                                    <ul class="mt-3 flex flex-wrap gap-2 font-mono text-xs md:text-[13px]">
                                        {entry.data.coursework.map((course) => (
                                                <li class="border border-line px-3 py-1.5">{course}</li>
                                        ))}
                                    </ul>
                                </div>
                        )}
                    </li>
            ))
        }
    </ol>
</section>

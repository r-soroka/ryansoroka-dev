---
/**
 * Experience: jobs and roles as cards, plus a resume download.
 * (Education and research have their own sections.)
 *
 * Reads every Markdown file in src/content/experience/. To add an entry,
 * add a file there — no changes needed in this component.
 */
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";
import { SITE } from "../site.config";

// Load all entries and sort them by their `order` field (lowest first).
const entries = (await getCollection("experience")).sort(
    (a, b) => a.data.order - b.data.order,
);

// Builds the date line, e.g. "2025 — NOW". `??` falls back to "Now" when
// there's no end date (something you're still doing).
const period = (start: string, end?: string) =>
    `${start} — ${end ?? "Now"}`.toUpperCase();
---

<section id="experience" class="border-t-2 border-line py-14 md:py-18">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <SectionHeading id="experience" />
        <!-- `download` saves the file instead of opening it in the browser. -->
        <a
                href={SITE.resume}
                download
                class="mb-8 flex min-h-11 items-center border border-accent px-4 font-mono text-xs tracking-wider text-accent hover:text-accent-light md:text-[13px]"
        >
            RESUME.PDF ↓
        </a>
    </div>

    <!-- Three cards across from md up; stacked on phones. -->
    <ol class="grid gap-5 md:grid-cols-3">
        {
            entries.map((entry) => (
                    <li class="border border-line bg-surface p-6 md:p-7">
                        <p class="font-mono text-xs text-accent md:text-[13px]">
                            {period(entry.data.start, entry.data.end)}
                        </p>
                        <h3 class="mt-4 text-xl font-bold">{entry.data.role}</h3>
                        <p class="mt-0.5 text-muted">{entry.data.organization}</p>
                        <p class="mt-3 text-[15px] text-text/80">{entry.data.summary}</p>
                    </li>
            ))
        }
    </ol>
</section>

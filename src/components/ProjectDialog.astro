---
/**
 * ProjectDialog: the "Details" popout for one project.
 *
 * Shows the project's name, stack, links and the longer description written
 * in the body of its Markdown file (everything below the --- frontmatter).
 * Rendered by ProjectRow, which opens it with the Details button.
 */
import { render, type CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
    /** Display code, e.g. "P-01". */
    code: string;
    /** Must match the id the Details button looks for. */
    dialogId: string;
}

const { project, code, dialogId } = Astro.props;

// Turns the Markdown body into a component we can drop in with <Content />.
const { Content } = await render(project);
---

<!--
    <dialog> is the browser's built-in popup. m-auto re-centers it (Tailwind's
    reset removes the default centering), and backdrop: styles the dim layer
    behind it. aria-labelledby tells screen readers the title of the dialog.
-->
<dialog
        id={dialogId}
        data-project-dialog
        aria-labelledby={`${dialogId}-title`}
        class="m-auto w-[min(640px,calc(100%-2rem))] max-h-[85vh] overflow-y-auto border border-line bg-surface p-0 text-text backdrop:bg-black/70"
>
    <div class="p-6 md:p-8">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="font-mono text-sm text-accent">
                    {code}{project.data.year !== undefined && ` · ${project.data.year}`}
                </p>
                <h3 id={`${dialogId}-title`} class="mt-1 text-2xl font-bold">
                    {project.data.name}
                </h3>
            </div>
            <!-- A button inside <form method="dialog"> closes the dialog, no JavaScript needed. -->
            <form method="dialog">
                <button
                        class="flex size-11 items-center justify-center border border-line font-mono text-muted hover:text-accent"
                        aria-label="Close"
                >
                    ✕
                </button>
            </form>
        </div>

        <p class="mt-4 font-mono text-xs text-muted md:text-[13px]">
            {project.data.stack.join(" · ")}
        </p>

        <!--
            The Markdown output has no classes of its own, so these [&_tag]:
            classes style the elements inside it (paragraphs, headings, lists, links).
        -->
        <div class="mt-6 text-muted [&_a]:text-accent [&_h2]:mt-6 [&_h2]:mb-2 [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_p]:mb-4">
            <Content />
        </div>

        <div class="mt-6 flex gap-2 font-mono text-xs md:text-[13px]">
            {project.data.github && (
                    <a href={project.data.github} target="_blank" class="flex min-h-11 items-center border border-line px-4 text-accent hover:text-accent-light">
                        GITHUB ↗
                    </a>
            )}
            {project.data.demo && (
                    <a href={project.data.demo} target="_blank" class="flex min-h-11 items-center border border-line px-4 text-accent hover:text-accent-light">
                        {project.data.demoLabel ?? "DEMO"} ↗
                    </a>
            )}
        </div>
    </div>
</dialog>

<script>
    // Close a project dialog when the dark backdrop around it is clicked.
    // Clicks on the backdrop report the <dialog> itself as the target; clicks
    // on the content inside report an inner element, so those are ignored.
    document
        .querySelectorAll<HTMLDialogElement>("dialog[data-project-dialog]")
        .forEach((dialog) => {
            dialog.addEventListener("click", (event) => {
                if (event.target === dialog) dialog.close();
            });
        });
</script>

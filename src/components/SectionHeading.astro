---
/**
 * SectionHeading: the "01 ABOUT" style title used by every section.
 *
 * The number and title come from NAV_SECTIONS in site.config.ts, so they
 * always match the header. Reorder sections there and both update.
 *
 * Usage:
 *   <SectionHeading id="projects" meta="INDEX · 3 ENTRIES" />
 */
import { NAV_SECTIONS, type SectionId } from "../site.config";

interface Props {
    /** Which section this heads, e.g. "about". */
    id: SectionId;
    /** Optional small label shown on the right, e.g. an entry count. */
    meta?: string;
}

const { id, meta } = Astro.props;
const index = NAV_SECTIONS.findIndex((s) => s.id === id);
const number = String(index + 1).padStart(2, "0");
const title = NAV_SECTIONS[index].label;
---

<div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="text-3xl font-extrabold tracking-tight uppercase md:text-[44px]">
        <span class="mr-3 align-top font-mono text-sm font-medium text-accent md:text-[15px]">
            {number}
        </span>
        {title}
    </h2>
    <!-- Only rendered when a meta label is passed in. -->
    {meta && <p class="font-mono text-xs tracking-widest text-faint">{meta}</p>}
</div>

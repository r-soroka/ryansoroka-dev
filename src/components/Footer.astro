---
/**
 * Footer: copyright line at the bottom of every page that includes it.
 * The year updates automatically each time the site is built.
 */
const year = new Date().getFullYear();
---

<footer
        class="flex flex-wrap justify-between gap-3 border-t border-line pt-6 pb-11 font-mono text-xs tracking-widest text-faint"
>
    <span>© {year} RYAN SOROKA</span>
    <span>END OF DOCUMENT</span>
</footer>

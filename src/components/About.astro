---
/**
 * About: quick facts on the left; headline, bio and skills grid on the right.
 *
 * All the text lives in ABOUT in site.config.ts — edit it there.
 */
import SectionHeading from "./SectionHeading.astro";
import { Icon } from "astro-icon/components";
import { ABOUT } from "../site.config";
---

<section id="about" class="border-t-2 border-line py-14 md:py-18">
    <!-- Narrow heading column + wide text column from md up; stacked on phones. -->
    <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:gap-12">
        <div>
            <SectionHeading id="about" />

            <!-- Quick facts: a thin line on the left of each, label above value. -->
            <dl class="grid gap-5">
                {ABOUT.facts.map((fact) => (
                    <div class="border-l-2 border-line pl-4">
                        <dt class="font-mono text-xs tracking-widest text-faint">{fact.label}</dt>
                        <dd class="mt-1 flex items-center gap-2">
                            {"dot" in fact && fact.dot && (
                                <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                            )}
                            {fact.value}
                        </dd>
                    </div>
                ))}
            </dl>
        </div>

        <div>
            <p class="text-xl leading-snug md:text-[22px]">{ABOUT.headline}</p>
            <p class="mt-5 text-muted">{ABOUT.bio}</p>

            <!--
                Divider trick: the list's background is the line color, the cells
                are surface-colored, and the 1px gap (gap-px) lets the line color
                show through between them.
            -->
            <dl
                    class="mt-8 grid gap-px border border-line bg-line font-mono text-xs sm:grid-cols-2 md:text-[13px]"
            >
                {
                    ABOUT.skills.map((group) => (
                            <div class="bg-surface p-4">
                                <dt class="tracking-widest text-faint">{group.label}</dt>
                                <!-- Each skill is a small chip; ones with an icon show its logo first. -->
                                <dd class="mt-3 flex flex-wrap gap-2">
                                    {group.items.map((item) => typeof item === "string" ? (
                                            <span class="border border-line px-2.5 py-1.5">{item}</span>
                                    ) : (
                                            <span class="flex items-center gap-1.5 border border-line px-2.5 py-1.5">
                                                <Icon name={item.icon} class="size-4 shrink-0 text-muted" aria-hidden="true" />
                                                {item.name}
                                            </span>
                                    ))}
                                </dd>
                            </div>
                    ))
                }
            </dl>
        </div>
    </div>
</section>

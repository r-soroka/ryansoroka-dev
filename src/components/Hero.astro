---
import { Icon } from "astro-icon/components";
import { SITE, HERO } from "../site.config";
import { Image } from "astro:assets";
import personal from "../assets/ryan-jet.png";
import SocialRail from "./SocialRail.astro";
---

<!--
    Text on the left, photo on the right from tablet width up; stacked on phones.
    md:pr-16 leaves a lane on the right for the social rail.
    md:pb-0 + md:items-end let the photo sit on the line below the hero.
-->
<section id="top" class="relative grid gap-10 pt-16 md:grid-cols-[2fr_3fr] md:items-end md:pt-24 md:pb-0 md:pr-16">
    <div class="space-y-6 md:pb-24">
        <h1 class="text-5xl leading-none font-extrabold tracking-tight uppercase md:text-7xl">
            <span class="block font-mono text-base font-normal tracking-widest text-muted md:text-lg">I'M</span>
            <span class="text-accent">{SITE.name}</span>
        </h1>

        <div>
            <p class="text-lg">{HERO.role}</p>
            <p class="mt-1 font-mono text-xs tracking-widest text-muted uppercase md:text-sm">{HERO.school}</p>
            <p class="mt-1 flex items-center gap-1.5 font-mono text-xs tracking-widest text-muted uppercase md:text-sm">
                <Icon name="mdi:map-marker-outline" class="size-4 text-accent" aria-hidden="true" />
                {HERO.location}
            </p>
        </div>

        <div class="flex flex-wrap gap-3 font-mono text-sm tracking-widest">
            <a href="#contact" class="rounded border border-accent bg-accent px-5 py-2 text-bg transition-colors hover:bg-accent-light">
                CONTACT ME
            </a>
            <a href={SITE.resume} target="_blank" class="rounded border border-line px-5 py-2 text-muted transition-colors hover:text-text">
                RÉSUMÉ ↗
            </a>
        </div>

        <SocialRail />
    </div>

    <Image
        src={personal}
        alt="Ryan Soroka standing in front of an F-16"
        widths={[600, 1200, personal.width]}
        sizes="(min-width: 768px) 60vw, 100vw"
        class="h-auto w-full grayscale-75 contrast-110"
    />
</section>

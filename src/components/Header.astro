---
import { SITE, NAV_SECTIONS } from "../site.config";

const navItems = NAV_SECTIONS.map((s, i) => ({
    number: String(i + 1).padStart(2, "0"),
    label: s.label,
    href: `#${s.id}`,
}));
---

<header class="flex items-center justify-between gap-6 border-b-2 border-line py-6">
    <a href="#top" class="flex items-center gap-2 font-mono text-xs tracking-widest md:text-sm">
        <span class="font-semibold text-accent">{SITE.initials}</span>
        <span class="text-line">/</span>
        <span class="uppercase text-muted">{SITE.domain}</span>
    </a>

    <div class="flex items-center gap-8 font-mono text-xs tracking-widest md:text-sm">
        <!-- Wide screens: the section links in a row. -->
        <nav class="hidden xl:block">
            <ul class="flex gap-5">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="flex gap-1.5 text-muted transition-colors hover:text-text">
                            <span class="text-accent">{item.number}</span>
                            <span>{item.label}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <a href={SITE.resume} target="_blank" class="whitespace-nowrap text-accent transition-colors hover:text-accent-light">
            RÉSUMÉ ↗
        </a>

        <!--
            Smaller screens: a MENU button that opens the same links in a panel.
            It uses the browser's built-in popover, so clicking outside or
            pressing Escape closes it with no extra code. Picking a link closes
            it too (the onclick).
        -->
        <button popovertarget="site-menu" class="cursor-pointer text-muted transition-colors hover:text-text xl:hidden">
            MENU
        </button>
        <nav
            id="site-menu"
            popover
            aria-label="Sections"
            class="inset-auto top-16 right-5 m-0 w-60 border border-line bg-surface p-2 text-text md:right-6"
        >
            <ul>
                {navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            onclick="this.closest('[popover]').hidePopover()"
                            class="flex gap-3 px-3 py-3 text-muted transition-colors hover:bg-bg hover:text-text"
                        >
                            <span class="text-accent">{item.number}</span>
                            <span>{item.label}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

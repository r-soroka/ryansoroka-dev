---
/**
 * ResearchDialog: the "Details" popout for one research entry.
 *
 * Shows the longer write-up from the body of the entry's Markdown file
 * (everything below the --- frontmatter), with the poster underneath.
 * Clicking the poster opens it full size in a new tab.
 */
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
    entry: CollectionEntry<"research">;
    /** Must match the id the Details button looks for. */
    dialogId: string;
}

const { entry, dialogId } = Astro.props;
const { Content } = await render(entry);
const { poster, posterAlt, title } = entry.data;
---

<dialog
        id={dialogId}
        data-research-dialog
        aria-labelledby={`${dialogId}-title`}
        class="m-auto w-[min(860px,calc(100%-2rem))] max-h-[90vh] overflow-y-auto border border-line bg-surface p-0 text-text backdrop:bg-black/70"
>
    <div class="p-6 md:p-8">
        <div class="flex items-start justify-between gap-4">
            <h3 id={`${dialogId}-title`} class="text-2xl font-bold">{title}</h3>
            <!-- A button inside <form method="dialog"> closes the dialog, no JavaScript needed. -->
            <form method="dialog">
                <button
                        class="flex size-11 items-center justify-center border border-line font-mono text-muted hover:text-accent"
                        aria-label="Close"
                >
                    ✕
                </button>
            </form>
        </div>

        <!-- The [&_tag]: classes style the elements inside the Markdown (paragraphs, headings, lists, links, tables). -->
        <div class="mt-6 text-muted [&_a]:text-accent [&_h2]:mt-6 [&_h2]:mb-2 [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_p]:mb-4 [&_strong]:text-text [&_table]:mb-4 [&_table]:w-full [&_table]:font-mono [&_table]:text-sm [&_td]:border [&_td]:border-line [&_td]:px-3 [&_td]:py-2 [&_th]:border [&_th]:border-line [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:text-text">
            <Content />
        </div>

        {poster && (
            <a href={poster.src} target="_blank" class="mt-6 block border border-line">
                <Image src={poster} alt={posterAlt ?? `Poster: ${title}`} widths={[800, 1600]} sizes="860px" class="h-auto w-full" />
            </a>
        )}
    </div>
</dialog>

<script>
    // Open the matching dialog when a research "Details" button is clicked,
    // and close it when the dark backdrop around it is clicked.
    document.querySelectorAll<HTMLButtonElement>("button[data-opens-research]").forEach((button) => {
        button.addEventListener("click", () => {
            const dialog = document.getElementById(button.dataset.opensResearch ?? "");
            if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
    });
    document.querySelectorAll<HTMLDialogElement>("dialog[data-research-dialog]").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
    });
</script>
